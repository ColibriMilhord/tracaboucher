# Identifiants de la base. config.php est versionné mais vide de secrets ;
# seul config.local.php les porte, et il ne quitte jamais le serveur.
config.local.php

# Installeur : ne doit pas être remis en ligne (expose le nom de la base
# et son utilisateur). Les évolutions de schéma passent par maj.php.
install.php
install_v2.sql

# Ancienne version v1, conservée localement seulement.
archive_v1/

# Photos des lots : données de l'atelier, pas du code.
uploads/*
!uploads/.htaccess
!uploads/entrees/
!uploads/fabrications/
uploads/entrees/*
uploads/fabrications/*
!uploads/entrees/index.html
!uploads/fabrications/index.html

# Divers
*.zip
*.log
.DS_Store
Thumbs.db

# Extraction accidentelle d'une ancienne archive, conservée localement.
tracabouchercamera/

# Agent balance : config réelle (jeton, mot de passe) et journaux — jamais versionnés
agent-balance/config.ps1
agent-balance/*.log
agent-balance/agent-statut.txt
agent-balance/dernier-hash.txt
